{
  "name": "ultimate-seo",
  "version": "0.1.9",
  "tablePrefix": "seo_",
  "description": "The one-stop SEO command centre for Cactus: site-wide SEO scoring, page-by-page analysis with one-click fixes, a full site crawl audit, sitemap and robots controls, and structured data blocks for the page builder.",
  "requiresCoreVersion": "0.5.1150",
  "permissions": [
    "seo.view",
    "seo.manage"
  ],
  "navEntries": [
    {
      "label": "SEO",
      "path": "/m/ultimate-seo",
      "icon": "<path d=\"M3 3v18h18\"/><path d=\"m7 13 4-4 4 3 5-6\"/>",
      "permission": "seo.view"
    }
  ],
  "settingsTabs": [
    {
      "id": "ultimate-seo",
      "label": "SEO",
      "permission": "seo.manage",
      "import": "./components/admin/SettingsTab",
      "component": "UltimateSeoSettingsTab"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "teardown": [
    "seo_settings",
    "seo_page_meta",
    "seo_audit_runs",
    "seo_audit_issues",
    "seo_robots_rules",
    "seo_sitemap_entries"
  ],
  "cronJobs": [
    {
      "path": "/api/m/ultimate-seo/cron/audit",
      "schedule": "0 4 * * 1"
    }
  ],
  "puckBlocks": [
    {
      "type": "SeoStructuredData",
      "import": "./components/puck/StructuredDataBlock",
      "component": "structuredDataPuckComponent",
      "rscComponent": "structuredDataPuckRscComponent"
    },
    {
      "type": "SeoFaq",
      "import": "./components/puck/FaqBlock",
      "component": "seoFaqPuckComponent",
      "rscComponent": "seoFaqPuckRscComponent"
    }
  ]
}
