{
  "name": "ultimate-seo",
  "version": "0.1.18",
  "tablePrefix": "seo_",
  "description": "The one-stop SEO command centre for Cactus: site-wide SEO scoring, page-by-page analysis with one-click fixes, a full site crawl audit, sitemap and robots controls, structured data blocks for the page builder, and the AI half - llms.txt, a Markdown twin of every page, AI crawler controls, AI referral figures, and a read-only endpoint agents can query - including a catalogue search by price, stock and category.",
  "requiresCoreVersion": "0.5.1584",
  "permissions": [
    "seo.view",
    "seo.manage"
  ],
  "navEntries": [
    {
      "label": "SEO",
      "path": "/m/ultimate-seo",
      "icon": "<path d=\"M3 3v18h18\"/><path d=\"m7 13 4-4 4 3 5-6\"/>",
      "permission": "seo.view"
    }
  ],
  "settingsTabs": [
    {
      "id": "ultimate-seo",
      "label": "SEO",
      "permission": "seo.manage",
      "import": "./components/admin/SettingsTab",
      "component": "UltimateSeoSettingsTab"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "teardown": [
    "seo_settings",
    "seo_page_meta",
    "seo_audit_runs",
    "seo_audit_issues",
    "seo_robots_rules",
    "seo_sitemap_entries",
    "seo_llm_documents",
    "seo_ai_hits"
  ],
  "cronJobs": [
    {
      "path": "/api/m/ultimate-seo/cron/audit",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/m/ultimate-seo/cron/ai",
      "schedule": "0 3 * * *"
    }
  ],
  "puckBlocks": [
    {
      "type": "SeoStructuredData",
      "import": "./components/puck/StructuredDataBlock",
      "component": "structuredDataPuckComponent",
      "rscComponent": "structuredDataPuckRscComponent"
    },
    {
      "type": "SeoFaq",
      "import": "./components/puck/FaqBlock",
      "component": "seoFaqPuckComponent",
      "rscComponent": "seoFaqPuckRscComponent"
    }
  ],
  "extensionPoints": [
    {
      "point": "core.agent-content",
      "id": "ultimate-seo",
      "import": "./lib/agent-content",
      "component": "ultimateSeoAgentContent",
      "serverOnly": true
    }
  ]
}
