{
  "name": "ultimate-seo",
  "version": "0.1.0",
  "tablePrefix": "seo_",
  "description": "The one-stop SEO command centre for Cactus: site-wide SEO scoring, page-by-page analysis with one-click fixes, a full site crawl audit, sitemap and robots controls, and structured data blocks for the page builder.",
  "requiresCoreVersion": "0.5.436",
  "permissions": [
    "seo.view",
    "seo.manage"
  ],
  "navGroupLabel": "SEO",
  "navEntries": [
